{
    "name": "vitamind/core",
    "description": "VitaminD Core - User management, authentication, admin infrastructure, and plugin engine for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wuri Nugrahadi",
            "email": "wuri.nugrahadi@gmail.com",
            "homepage": "https://nugrahadi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "laravel/fortify": "^1.19",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/laravel-route-attributes": "^1.20",
        "inertiajs/inertia-laravel": "^0.6|^1.0|^3.0",
        "vitamind/plugin-sdk": "dev-main|dev-add-readme-and-tests"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VitaminD\\Core\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VitaminD\\Core\\Tests\\": "tests/"
        }
    }
}
