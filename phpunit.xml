<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Core">
            <directory>dev-packages/vitamind-core/tests</directory>
        </testsuite>
        <testsuite name="Workspace">
            <directory>dev-packages/vitamind-workspace-plugin/tests</directory>
        </testsuite>
        <testsuite name="PluginSdk">
            <directory>dev-packages/vitamind-plugin-sdk/tests</directory>
        </testsuite>
        <testsuite name="Realtime">
            <directory>dev-packages/vitamind-realtime-plugin/tests</directory>
        </testsuite>
        <testsuite name="Archive">
            <directory>dev-packages/vitamind-archive-plugin/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>dev-packages/vitamind-core/src</directory>
            <directory>dev-packages/vitamind-workspace-plugin/src</directory>
            <directory>dev-packages/vitamind-plugin-sdk/src</directory>
            <directory>dev-packages/vitamind-realtime-plugin/src</directory>
            <directory>dev-packages/vitamind-archive-plugin/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="VITAMIND_FEATURE_WORKSPACES" value="true"/>
        <env name="VITAMIND_FEATURE_WEBSOCKET" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
